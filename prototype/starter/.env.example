# Copy to .env.local for local work, and add the same keys in Vercel > Project > Settings > Environment Variables.

# Database. Leave empty to use the in-memory demo store (data resets on every restart and is NOT shared across Vercel instances).
# Vercel Postgres, Neon, or Supabase connection string.
DATABASE_URL=

# Photo and signature storage. Leave empty to keep images inline (demo only).
BLOB_READ_WRITE_TOKEN=

# Masked calls and texts (Twilio Proxy or Twilio Voice/SMS). [CONFIRM provider]
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PROXY_SERVICE_SID=

# Smart lock access (Seam covers August, Yale, Schlage, Kwikset and more). [CONFIRM partners]
SEAM_API_KEY=

# Push notifications (OneSignal or web push). [CONFIRM provider]
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# Auth (Clerk or Auth.js). Required before real data. [CONFIRM provider]
AUTH_SECRET=
