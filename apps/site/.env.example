# Landing site (apps/site). Set the same keys in the Vercel project's Environment Variables.

# Shared Neon database (contact form -> hop_inquiries)
DATABASE_URL=

# Contact form owner email (Resend)
RESEND_API_KEY=
NOTIFY_EMAIL=

# Sign-in links on /portal. Leave one empty to show "Coming soon" for that app.
VITE_CLIENT_URL=
VITE_CONSOLE_URL=
VITE_REP_URL=
VITE_FACILITY_URL=
