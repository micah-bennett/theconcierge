# Landing site (apps/site). Set the same keys in the Vercel project's Environment Variables.

# Shared Neon database (contact form -> hop_inquiries, instant request form -> portal_requests)
DATABASE_URL=

# Contact form and instant request owner email (Resend)
RESEND_API_KEY=
NOTIFY_EMAIL=

# Sign-in links on /portal (and /concierge, /request for the Concierge Portal).
# Leave one empty to show "Coming soon" for that app.
VITE_CLIENT_URL=
VITE_CONSOLE_URL=
VITE_REP_URL=
VITE_FACILITY_URL=
VITE_CONCIERGE_URL=
