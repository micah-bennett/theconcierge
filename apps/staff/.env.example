# HOP Client (apps/staff, formerly the Staff App). Copy to .env.local; set the same keys in this app's Vercel project.
DATABASE_URL=
SESSION_HASH_SECRET=
RESEND_API_KEY=
# This app's own base URL, used in emailed links and invite links, e.g. http://localhost:3001
APP_URL=http://localhost:3001
# HOP Client's public URL (invite links use it; falls back to APP_URL)
CLIENT_URL=http://localhost:3001
# Legacy name of CLIENT_URL, still read as a fallback
# STAFF_URL=http://localhost:3001
# The other apps, for "This account is for the …" links
CONSOLE_URL=http://localhost:3002
REP_URL=http://localhost:3003
FACILITY_URL=http://localhost:3004
# HOP's social accounts for the Follow rewards, JSON. Unset networks don't show. Example:
# SOCIAL_LINKS={"instagram":"https://instagram.com/…","facebook":"https://facebook.com/…","linkedin":"https://linkedin.com/company/…","tiktok":"https://tiktok.com/@…"}
SOCIAL_LINKS=
