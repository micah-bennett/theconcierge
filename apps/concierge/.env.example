# Concierge Portal (apps/concierge). Copy to .env.local; set the same keys in this app's Vercel project.
DATABASE_URL=
SESSION_HASH_SECRET=
RESEND_API_KEY=
# This app's own base URL, used in emailed links (password reset), e.g. http://localhost:3005
APP_URL=http://localhost:3005
# The other apps, for "This account is for the …" links when someone signs in here with another role
CLIENT_URL=http://localhost:3001
CONSOLE_URL=http://localhost:3002
REP_URL=http://localhost:3003
FACILITY_URL=http://localhost:3004
