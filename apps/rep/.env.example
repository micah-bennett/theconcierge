# Concierge Rep App (apps/rep). Copy to .env.local; set the same keys in this app's Vercel project.
DATABASE_URL=
SESSION_HASH_SECRET=
RESEND_API_KEY=
# This app's own base URL, used in emailed links, e.g. http://localhost:3003
APP_URL=http://localhost:3003
# The other apps, for "This account is for the …" links and invite emails
STAFF_URL=http://localhost:3001
CONSOLE_URL=http://localhost:3002
REP_URL=http://localhost:3003
FACILITY_URL=http://localhost:3004
# Optional: Vercel Blob for photo/signature proof (inline data URLs without it, demo only)
BLOB_READ_WRITE_TOKEN=
