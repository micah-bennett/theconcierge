# Server-only Vercel Function configuration. Never prefix these with VITE_.
DATABASE_URL=
RESEND_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=google/gemini-2.5-flash

# Optional overrides
NOTIFY_EMAIL=micah@hvconcierge.com

# HOP login (required for /hop/app and /hop/admin)
# Random secret used to hash session tokens before storing them — generate with
# `openssl rand -hex 32`. Rotating this logs everyone out.
SESSION_HASH_SECRET=

# HOP — Google Calendar integration (see docs/hop/architecture.md). Create an OAuth client in
# Google Cloud Console (APIs & Services > Credentials) with the Calendar API enabled, and add
# GOOGLE_REDIRECT_URI as an authorized redirect URI (one entry per environment, e.g. both the
# localhost:3000 value for `vercel dev` and the production domain).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/hop/integrations/google/callback
